@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/faultdebugTargets.cmake")
if(TARGET faultdebug::faultdebug_runtime AND NOT TARGET faultdebug_runtime)
  add_library(faultdebug_runtime ALIAS faultdebug::faultdebug_runtime)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/FaultDebugLegacy.cmake")

set(faultdebug_VERSION "@PROJECT_VERSION@")
set(faultdebug_CMAKE_MODULE_DIR "${CMAKE_CURRENT_LIST_DIR}")
check_required_components(faultdebug)
