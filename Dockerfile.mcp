FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /opt/faultdebug
COPY pyproject.toml README.md LICENSE ./
COPY faultdebug ./faultdebug
COPY scripts/faultdebug-cc scripts/faultdebug-cxx ./scripts/

RUN pip install --no-cache-dir . \
    && mkdir -p /artifacts \
    && chown 65532:65532 /artifacts

USER 65532:65532
ENTRYPOINT ["fault-debug"]
CMD ["mcp", "--root", "/artifacts"]
